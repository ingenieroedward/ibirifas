generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "SUPERADMIN" | "ORGANIZER" | "SELLER" (plain string, validated in code —
// matches the existing convention for status/paymentStatus rather than a Prisma enum).
//
// Tenancy: a SUPERADMIN has no owner. An ORGANIZER is a tenant root (ownerId
// null) and owns Raffles directly. A SELLER belongs to exactly one ORGANIZER
// via ownerId and inherits access to all of that organizer's raffles — there
// is no separate per-raffle assignment yet.
model AdminUser {
  id            String         @id @default(cuid())
  name          String
  codeHash      String
  role          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  ownerId       String?
  owner         AdminUser?     @relation("OwnedUsers", fields: [ownerId], references: [id], onDelete: Cascade)
  ownedUsers    AdminUser[]    @relation("OwnedUsers")

  // Set only on ORGANIZERs (the tenant root). The "which organization" half of
  // logging in: an organizer's team (the organizer plus their sellers) shares
  // it, and login codes only need to be unique inside that team. A SELLER's
  // organization code is their organizer's; a SUPERADMIN has none.
  orgCode       String?        @unique

  // Only meaningful for ORGANIZER; a placeholder for a future paid-plans
  // system the superadmin will configure — unused/unenforced today.
  plan          String         @default("free")

  // Only meaningful for ORGANIZER: the organization's default for letting people
  // reserve numbers from a raffle's public link. Each raffle can override it.
  publicReservations Boolean    @default(false)
  // Only meaningful for ORGANIZER: where buyers' replies to our emails go (Reply-To), and where a test
  // email is sent. Optional.
  contactEmail  String?
  // Only meaningful for ORGANIZER: a Bre-B payment reported by the bank (pagoradar) that matches exactly one
  // reservation is approved on its own. Off = it is only suggested and the team approves it.
  autoApprovePayments Boolean @default(true)
  // Only meaningful for ORGANIZER: their receiving account in pagoradar (the bank inbox that forwards the
  // payment notices of their own account). Null = not connected.
  pagoradarAccountId String? @unique
  // Only meaningful for ORGANIZER: when they accepted the platform's terms of use (they, not Ibirifas, answer
  // for their raffles: permits, prizes, buyers' data). Asked again when the terms change (lib/terms.ts).
  termsAcceptedAt DateTime?

  refreshTokens RefreshToken[]
  pushSubscriptions PushSubscription[]
  raffles       Raffle[]       @relation("RaffleOwner")
  updates       RaffleNumber[] @relation("UpdatedBy")
  sales         RaffleNumber[] @relation("SoldBy")

  @@index([ownerId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One row per browser/device that turned on notifications. `endpoint` is the
// push service URL the browser handed us (unique per device), and p256dh/auth
// are that device's encryption keys — together they are all web-push needs to
// deliver an encrypted message. A row is dropped when the push service reports
// the device gone (404/410) or the user turns notifications off.
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  // The site the browser subscribed on (https://ibirifas.com). A subscription belongs to that site's service
  // worker, so after a domain change the old one would keep showing every notification a second time: when
  // someone subscribes on the current site, their subscriptions from any other site (or unknown, older rows) go.
  origin    String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Raffle {
  id           String         @id @default(cuid())
  ownerId      String
  owner        AdminUser      @relation("RaffleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  prizeLabel   String?
  // The official lottery draw the winning number is taken from (e.g. "Sinuano
  // Noche", "Baloto") — how informal Colombian raffles actually determine a
  // winner: the last digits of that lottery's real result on drawDate.
  // Optional free text; null when the raffle runs its own independent draw.
  lottery      String?
  // The raffle's permit as the organizer wants it shown (e.g. "Resolución 123 de 2026 · Alcaldía de Montería").
  // Optional free text: displayed on the public page and the share image when set.
  permit       String?
  numberPrice  Int
  totalNumbers Int            @default(100)
  drawDate     DateTime?
  // When the draw is played: on `drawDate` ("date"), or once every number is sold ("sold") or paid ("paid").
  // With the last two, drawDate may stay empty until the raffle fills up; `completedAt` marks the moment the
  // condition became true (the team is told once, and it clears again if numbers are freed).
  drawTrigger  String         @default("date")
  completedAt  DateTime?
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  numbers      RaffleNumber[]

  // Set when the organizer closes the raffle after the draw. `winnerValue` is
  // the winning number (null when it was closed without a draw); it is only
  // meaningful while status is "closed".
  winnerValue  Int?
  closedAt     DateTime?

  // Secret in the raffle's public, read-only page (/p/<token>): buyers see what
  // is still available without logging in. Null = no public page. Random and
  // unguessable; the organizer can rotate it (the old link stops working) or
  // switch it off.
  publicToken  String?        @unique

  // Sold-but-unpaid numbers ("apartados") that sit for more than `holdDays`
  // days are overdue. Null = they never expire. With `autoRelease` they go back
  // on sale by themselves; otherwise the team is only warned (at most once a
  // day, `expiryNoticeAt` remembers when).
  holdDays        Int?

  // Reservations from the public link: null follows the organization's default,
  // "on" / "off" override it. They also need `holdDays` (an unpaid reservation
  // must be able to expire) — see lib/reservations.ts.
  publicReservations String?

  autoRelease     Boolean      @default(false)
  expiryNoticeAt  DateTime?

  // Per-raffle grid theme override (hex strings like "#0b0b0f"). Null means
  // "use the app's default gold/black look" — these are opt-in, not required.
  themeBackground   String?
  themeNumberColor  String?
  themeTextColor    String?

  accounts     RaffleAccount[]

  // A raffle "by stages" (etapas): the same number plays several draws in a row, each with its own prize,
  // paid in one installment (cuota) per stage. Empty = an ordinary raffle with a single draw.
  stages            RaffleStage[]
  visits            RaffleVisit[]
  // Installments for a stage must be paid this many days before its draw; later ones don't count for it.
  stageDeadlineDays Int        @default(3)
  // What paying every installment up front earns: "none", "discount" (fullPayDiscount pesos off) or "draw"
  // (a bonus stage, flagged `bonus`, that only numbers paid in full before the first deadline play).
  fullPayPerk       String     @default("none")
  fullPayDiscount   Int?

  // Optional "sets" (A, B, C…). When a raffle has groups, each group's numbers
  // are sold together at the group's price; numbers without a group stay loose
  // and sell one by one at `numberPrice`.
  groups       RaffleGroup[]

  @@index([ownerId])
}

// One draw of a raffle by stages. Stages are played in `position` order; each non-bonus stage costs one
// installment (`price`) and a number plays it only if it has paid that many installments by the stage's
// deadline. The result is stored once drawn: `outcome` "won" (the number was up to date, `winnerName` is its
// buyer) or "house" (it wasn't, or nobody had it: the prize stays with the organizer).
model RaffleStage {
  id          String    @id @default(cuid())
  raffleId    String
  raffle      Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  position    Int
  label       String
  prize       String
  price       Int
  bonus       Boolean   @default(false)
  lottery     String?
  drawDate    DateTime?
  winnerValue Int?
  outcome     String?
  winnerName  String?
  drawnAt     DateTime?
  createdAt   DateTime  @default(now())

  @@unique([raffleId, position])
  @@index([raffleId])
}

// One installment paid on a number of a raffle by stages: installment `quota` (1, 2, 3…) of `amount`
// pesos, collected by `method` at `paidAt`. Deleted when the number is freed.
model NumberQuota {
  id        String       @id @default(cuid())
  numberId  String
  number    RaffleNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  raffleId  String
  quota     Int
  amount    Int
  method    String
  paidAt    DateTime     @default(now())
  byId      String?

  @@unique([numberId, quota])
  @@index([raffleId])
}

// A lettered set of numbers sold as one unit. Which numbers belong to it is
// decided when the raffle is created (drawn at random or picked by hand) and
// never changes afterwards, so a sale can rely on it.
model RaffleGroup {
  id        String         @id @default(cuid())
  raffleId  String
  raffle    Raffle         @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  label     String         // "A", "B"… unique within the raffle
  price     Int            // what the whole set costs
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  numbers   RaffleNumber[]

  @@unique([raffleId, label])
  @@index([raffleId])
}

// A payment account the organizer publishes on the raffle (Nequi, Bancolombia,
// etc.) so buyers know where to pay. `holderName` ("responsable") is optional —
// Colombian informal transfers often need the account-holder's name confirmed,
// but not every organizer wants to disclose it.
model RaffleAccount {
  id         String   @id @default(cuid())
  raffleId   String
  raffle     Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  label      String   // e.g. "Nequi", "Bancolombia", "Daviplata"
  number     String   // free text — phone numbers, account numbers, etc. vary in format
  holderName String?  // "responsable" — optional, shown only when set
  // "bank": a regular account; "breb": a Bre-B llave (the key goes in `number`, its type in `keyType`).
  kind       String   @default("bank")
  keyType    String?  // breb only: "phone" | "email" | "document" | "alias" | "other"
  qrDataUrl  String?  // optional QR image the bank gives for the llave (PNG/JPEG data URL)
  hasQr      Boolean  @default(false) // so lists don't have to load the image to know there is one
  position   Int      @default(0) // preserves the order the organizer entered them in
  createdAt  DateTime @default(now())

  @@index([raffleId])
}

// Payments are collected manually today (cash/Nequi/transfer in person) —
// paymentMethod records how, set by the organizer/seller when marking a
// number "paid". paymentRef stays an unused placeholder for a future
// payment-gateway integration (a transaction/reference id), so that
// integration only needs to populate existing fields, not migrate the schema.
model RaffleNumber {
  id            String     @id @default(cuid())
  raffleId      String
  raffle        Raffle     @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  value         Int
  status        String     @default("available")
  buyerName     String?
  buyerPhone    String?
  photoDataUrl  String?
  paymentStatus String     @default("pending")
  paymentMethod String?
  paymentRef    String?
  notes         String?
  updatedById   String?
  updatedBy     AdminUser? @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  // Who sold the number and when it left the "available" state — unlike
  // updatedBy, these don't change when someone else later collects the payment,
  // so they are what sales reports and overdue holds are based on.
  soldById      String?
  soldBy        AdminUser? @relation("SoldBy", fields: [soldById], references: [id])
  soldAt        DateTime?
  // Reserved by a visitor of the public link (nobody on the team sold it).
  online        Boolean    @default(false)
  // Secret handed to the visitor who reserved it, so they (and only they) can
  // attach their payment receipt afterwards. Same value on all of one
  // reservation's numbers; cleared when the numbers are freed or resold.
  holdToken     String?
  // Optional email left by a visitor who reserved online: where we tell them about their reservation
  // (receipt received, payment approved or rejected, released). Cleared with the buyer.
  buyerEmail    String?
  // The team rejected the receipt the buyer sent (it was removed so they can send another): when and why.
  receiptRejectedAt   DateTime?
  receiptRejectReason String?
  // When the online buyer accepted the privacy notice (their authorization to process their data).
  privacyConsentAt    DateTime?
  // Who owns the account the payment came from, as the buyer typed it with the receipt: what the bank's
  // notice shows, so a payment can be matched to its reservation.
  payerName           String?
  // Installments paid, for a raffle by stages.
  quotas        NumberQuota[]

  // Null = a loose number sold on its own; otherwise it can only be sold, paid
  // or released together with the rest of its group.
  groupId       String?
  group         RaffleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([raffleId, value])
  @@index([raffleId, status])
  @@index([groupId])
  @@index([soldById])
  @@index([holdToken])
}

// Visits to a raffle's public link: one row per visitor per day (Colombia time). The visitor is a
// one-way hash of IP + browser + day, so nobody can be followed from one day to the next.
model RaffleVisit {
  id        String   @id @default(cuid())
  raffleId  String
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  day       String
  visitor   String
  views     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([raffleId, day, visitor])
  @@index([raffleId, day])
}

// A payment the bank reported (through pagoradar: a Bre-B transfer that reached the organization's account),
// and what was done with it. `id` is pagoradar's own id, so the same notice is never stored twice.
//   status: "auto"      matched exactly one reservation and approved it on its own
//           "approved"  the team approved it for a reservation
//           "review"    it could be one of several reservations, or the name doesn't fully match: the team decides
//           "unmatched" no reservation for that amount
//           "ignored"   the team set it aside (not a raffle payment, a duplicate…)
// The numbers it paid carry its id in RaffleNumber.paymentRef, which is how "Deshacer" finds them.
model ReceivedPayment {
  id          String    @id
  ownerId     String
  bank        String
  method      String?
  amount      Int
  payerName   String
  payerBank   String?
  reference   String?
  paidAt      DateTime
  // When pagoradar got it (its clock): the cursor for catching up on missed notices.
  sourceReceivedAt DateTime
  createdAt   DateTime  @default(now())
  status      String
  raffleId    String?
  // A short description of what it paid ("Ana Pérez · 04, 05"), kept even if the numbers change later.
  matchLabel  String?
  // Why it is waiting for the team, in plain words.
  note        String?
  // Who approved, ignored or undid it; null with "auto".
  resolvedById String?
  resolvedAt  DateTime?

  @@index([ownerId, status])
  @@index([ownerId, sourceReceivedAt])
}
