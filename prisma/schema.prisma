generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "SUPERADMIN" | "ORGANIZER" | "SELLER" (plain string, validated in code —
// matches the existing convention for status/paymentStatus rather than a Prisma enum).
//
// Tenancy: a SUPERADMIN has no owner. An ORGANIZER is a tenant root (ownerId
// null) and owns Raffles directly. A SELLER belongs to exactly one ORGANIZER
// via ownerId and inherits access to all of that organizer's raffles — there
// is no separate per-raffle assignment yet.
model AdminUser {
  id            String         @id @default(cuid())
  name          String
  codeHash      String
  role          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  ownerId       String?
  owner         AdminUser?     @relation("OwnedUsers", fields: [ownerId], references: [id], onDelete: Cascade)
  ownedUsers    AdminUser[]    @relation("OwnedUsers")

  // Set only on ORGANIZERs (the tenant root). The "which organization" half of
  // logging in: an organizer's team (the organizer plus their sellers) shares
  // it, and login codes only need to be unique inside that team. A SELLER's
  // organization code is their organizer's; a SUPERADMIN has none.
  orgCode       String?        @unique

  // Only meaningful for ORGANIZER; a placeholder for a future paid-plans
  // system the superadmin will configure — unused/unenforced today.
  plan          String         @default("free")

  // Only meaningful for ORGANIZER: the organization's default for letting people
  // reserve numbers from a raffle's public link. Each raffle can override it.
  publicReservations Boolean    @default(false)

  refreshTokens RefreshToken[]
  pushSubscriptions PushSubscription[]
  raffles       Raffle[]       @relation("RaffleOwner")
  updates       RaffleNumber[] @relation("UpdatedBy")
  sales         RaffleNumber[] @relation("SoldBy")

  @@index([ownerId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One row per browser/device that turned on notifications. `endpoint` is the
// push service URL the browser handed us (unique per device), and p256dh/auth
// are that device's encryption keys — together they are all web-push needs to
// deliver an encrypted message. A row is dropped when the push service reports
// the device gone (404/410) or the user turns notifications off.
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Raffle {
  id           String         @id @default(cuid())
  ownerId      String
  owner        AdminUser      @relation("RaffleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  prizeLabel   String?
  // The official lottery draw the winning number is taken from (e.g. "Sinuano
  // Noche", "Baloto") — how informal Colombian raffles actually determine a
  // winner: the last digits of that lottery's real result on drawDate.
  // Optional free text; null when the raffle runs its own independent draw.
  lottery      String?
  numberPrice  Int
  totalNumbers Int            @default(100)
  drawDate     DateTime?
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  numbers      RaffleNumber[]

  // Set when the organizer closes the raffle after the draw. `winnerValue` is
  // the winning number (null when it was closed without a draw); it is only
  // meaningful while status is "closed".
  winnerValue  Int?
  closedAt     DateTime?

  // Secret in the raffle's public, read-only page (/p/<token>): buyers see what
  // is still available without logging in. Null = no public page. Random and
  // unguessable; the organizer can rotate it (the old link stops working) or
  // switch it off.
  publicToken  String?        @unique

  // Sold-but-unpaid numbers ("apartados") that sit for more than `holdDays`
  // days are overdue. Null = they never expire. With `autoRelease` they go back
  // on sale by themselves; otherwise the team is only warned (at most once a
  // day, `expiryNoticeAt` remembers when).
  holdDays        Int?

  // Reservations from the public link: null follows the organization's default,
  // "on" / "off" override it. They also need `holdDays` (an unpaid reservation
  // must be able to expire) — see lib/reservations.ts.
  publicReservations String?

  autoRelease     Boolean      @default(false)
  expiryNoticeAt  DateTime?

  // Per-raffle grid theme override (hex strings like "#0b0b0f"). Null means
  // "use the app's default gold/black look" — these are opt-in, not required.
  themeBackground   String?
  themeNumberColor  String?
  themeTextColor    String?

  accounts     RaffleAccount[]

  // Optional "sets" (A, B, C…). When a raffle has groups, each group's numbers
  // are sold together at the group's price; numbers without a group stay loose
  // and sell one by one at `numberPrice`.
  groups       RaffleGroup[]

  @@index([ownerId])
}

// A lettered set of numbers sold as one unit. Which numbers belong to it is
// decided when the raffle is created (drawn at random or picked by hand) and
// never changes afterwards, so a sale can rely on it.
model RaffleGroup {
  id        String         @id @default(cuid())
  raffleId  String
  raffle    Raffle         @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  label     String         // "A", "B"… unique within the raffle
  price     Int            // what the whole set costs
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  numbers   RaffleNumber[]

  @@unique([raffleId, label])
  @@index([raffleId])
}

// A payment account the organizer publishes on the raffle (Nequi, Bancolombia,
// etc.) so buyers know where to pay. `holderName` ("responsable") is optional —
// Colombian informal transfers often need the account-holder's name confirmed,
// but not every organizer wants to disclose it.
model RaffleAccount {
  id         String   @id @default(cuid())
  raffleId   String
  raffle     Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  label      String   // e.g. "Nequi", "Bancolombia", "Daviplata"
  number     String   // free text — phone numbers, account numbers, etc. vary in format
  holderName String?  // "responsable" — optional, shown only when set
  position   Int      @default(0) // preserves the order the organizer entered them in
  createdAt  DateTime @default(now())

  @@index([raffleId])
}

// Payments are collected manually today (cash/Nequi/transfer in person) —
// paymentMethod records how, set by the organizer/seller when marking a
// number "paid". paymentRef stays an unused placeholder for a future
// payment-gateway integration (a transaction/reference id), so that
// integration only needs to populate existing fields, not migrate the schema.
model RaffleNumber {
  id            String     @id @default(cuid())
  raffleId      String
  raffle        Raffle     @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  value         Int
  status        String     @default("available")
  buyerName     String?
  buyerPhone    String?
  photoDataUrl  String?
  paymentStatus String     @default("pending")
  paymentMethod String?
  paymentRef    String?
  notes         String?
  updatedById   String?
  updatedBy     AdminUser? @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  // Who sold the number and when it left the "available" state — unlike
  // updatedBy, these don't change when someone else later collects the payment,
  // so they are what sales reports and overdue holds are based on.
  soldById      String?
  soldBy        AdminUser? @relation("SoldBy", fields: [soldById], references: [id])
  soldAt        DateTime?
  // Reserved by a visitor of the public link (nobody on the team sold it).
  online        Boolean    @default(false)
  // Secret handed to the visitor who reserved it, so they (and only they) can
  // attach their payment receipt afterwards. Same value on all of one
  // reservation's numbers; cleared when the numbers are freed or resold.
  holdToken     String?

  // Null = a loose number sold on its own; otherwise it can only be sold, paid
  // or released together with the rest of its group.
  groupId       String?
  group         RaffleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([raffleId, value])
  @@index([raffleId, status])
  @@index([groupId])
  @@index([soldById])
  @@index([holdToken])
}
