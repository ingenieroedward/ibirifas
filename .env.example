DATABASE_URL="file:./dev.db"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
REFRESH_TOKEN_PEPPER="replace-with-a-different-long-random-string"

# Push notifications (optional). Generate a pair with:  npx web-push generate-vapid-keys
# Without them the app works normally and the notifications bell is hidden.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Public address, used for links in emails (optional but recommended in production).
APP_URL=""
# 1 = only Dokploy/Traefik in front; 2 = Cloudflare proxy (orange cloud) + Traefik.
TRUSTED_PROXY_HOPS="1"

# Email to buyers (optional): any SMTP server (Resend, Brevo, Gmail app password…).
# Port 465 = TLS from the start; 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rifas <rifas@tu-dominio.com>"

# Cloudflare Turnstile on public reservations (optional): both keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Charging organizers per raffle (optional; README "Cobro por rifa"). BILLING=off turns it off.
BILLING=""
RAFFLE_PRICE_SMALL="15000"
RAFFLE_PRICE_LARGE="35000"
# Your own pagoradar receiving account (acc_…): raffles activate themselves when paid.
PAGORADAR_BILLING_ACCOUNT=""
# Your WhatsApp (with country code) for activations paid by hand.
BILLING_WHATSAPP=""

# Demo organization code (first start only). Organizers and sellers log in with
# this plus their own 6-digit code; the superadmin logs in with no organization.
SEED_ORG_CODE="demo"
