DATABASE_URL="file:./dev.db"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
REFRESH_TOKEN_PEPPER="replace-with-a-different-long-random-string"

# Push notifications (optional). Generate a pair with:  npx web-push generate-vapid-keys
# Without them the app works normally and the notifications bell is hidden.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
